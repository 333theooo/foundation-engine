# ---------------------------------------------------------------------------
# Atrium Studio — environment configuration
#
# Copy this file to `.env` and fill in the values. Everything is validated at
# startup by src/server/env.ts, so a missing or malformed value fails fast with
# a readable message instead of at some later request.
# ---------------------------------------------------------------------------

# NODE_ENV is set by Next itself (development for `next dev`, production for
# `next build` and `next start`). Do not set it here.

# --- Database --------------------------------------------------------------
# Required. `docker compose up -d db` starts a matching Postgres 16 instance.
DATABASE_URL="postgresql://atrium:atrium@localhost:5432/atrium?schema=public"

# --- Authentication --------------------------------------------------------
# Required. Signs session cookies. Must be at least 32 characters in production.
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Absolute origin of this deployment. Used for cookie scoping and absolute URLs.
APP_URL="http://localhost:3000"

# Set to false to require an account for every session.
ENABLE_GUEST_MODE=true

# --- AI provider -----------------------------------------------------------
# OPTIONAL. Without a key the application runs its deterministic local
# interpreter, which understands the built-in example prompts and keeps every
# other feature — geometry, persistence, undo, import/export, tests — working.
# Set a key to use Claude for open-ended architectural reasoning.
#
#   auto      use Anthropic when ANTHROPIC_API_KEY is set, otherwise mock
#   anthropic require Anthropic (startup fails without a key)
#   mock      always use the local interpreter
AI_PROVIDER=auto
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT_MS=120000

# --- Object storage --------------------------------------------------------
# `local` writes uploads under LOCAL_STORAGE_DIR and needs no credentials.
# `s3` targets any S3-compatible service (AWS S3, MinIO, R2, Backblaze B2).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="atrium-studio"
# S3_ACCESS_KEY_ID="replace-me"
# S3_SECRET_ACCESS_KEY="replace-me"
# S3_FORCE_PATH_STYLE=true

# --- Limits ----------------------------------------------------------------
RATE_LIMIT_AI_PER_HOUR=120
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_AUTH_PER_HOUR=30

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
