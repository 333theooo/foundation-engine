{
  "name": "foundation-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Atrium Studio - a conversational 3D architectural workspace",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "npm install && prisma generate && prisma migrate deploy && npm run db:seed",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.69.0",
    "@aws-sdk/client-s3": "3.926.0",
    "@aws-sdk/s3-request-presigner": "3.926.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dxf-parser": "1.1.2",
    "lucide-react": "0.544.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "pino": "9.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "3.0.6",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "three": "0.180.0",
    "web-ifc": "0.0.75",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "dotenv": "^17.2.3",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "prisma": "7.10.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
